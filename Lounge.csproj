<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Lounge</RootNamespace>
    <AssemblyName>Lounge</AssemblyName>
    <Version>1.0.21</Version>
    <Company>Fezcode</Company>
    <Product>Lounge</Product>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Lounge.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Agent/**;tests/**;tools/**;native/**;dist/**" />
    <None Remove="Agent/**;tests/**;tools/**;dist/**" />
    <AvaloniaResource Include="Assets/**" />
    <!-- FFmpeg 8 + libass, staged by tools/fetch-native.ps1. Loaded from ffmpeg/ beside the exe. -->
    <Content Include="native/win-x64/*.dll" Link="ffmpeg/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- AllOff (github.com/fezcode/alloff), bundled as a git subtree in extensions/AllOff:
         Lounge runs its in-page function from the web view's Extensions menu (PageScripts). -->
    <None Remove="extensions/**" />
    <EmbeddedResource Include="extensions/AllOff/popup/popup.js" LogicalName="AllOff/popup.js" />
    <EmbeddedResource Include="extensions/AllOff/manifest.json" LogicalName="AllOff/manifest.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
  <!-- WebView2 ships WPF and WinForms wrappers; Lounge hosts the Core API in its own
       child window, so drop them (they also drag in a second WindowsBase). -->
  <Target Name="DropWebView2Wrappers" BeforeTargets="ResolveAssemblyReferences" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
</Project>
