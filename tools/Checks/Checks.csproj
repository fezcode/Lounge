<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Lounge.Checks</RootNamespace>
    <AssemblyName>Lounge.Checks</AssemblyName>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../Media/**/*.cs" LinkBase="Media" />
    <Compile Include="../../Platform/**/*.cs" LinkBase="Platform" />
    <Compile Include="../../Shell/**/*.cs" LinkBase="Shell" />
    <Compile Include="../../Screens/**/*.cs" LinkBase="Screens" />
    <Compile Include="../../Controls/**/*.cs" LinkBase="Controls" />
    <Compile Include="../../App.cs" Link="App.cs" />
    <AvaloniaResource Include="../../App.axaml" Link="App.axaml" />
    <AvaloniaResource Include="../../Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../native/win-x64/*.dll" Link="ffmpeg/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
</Project>

